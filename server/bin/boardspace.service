[Unit]
Description=Boardspace Game Server
After=network.target mysql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=boardspace
Group=users
WorkingDirectory=/home/boardspace/server
ExecStartPre=/home/boardspace/server/buildconf.sh
ExecStart=/home/boardspace/server/runserver.sh
RestartSec=5
Restart=always
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
 